<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Enable queries for local offline IPC companion applications (Android 11+) -->
    <queries>
        <package android:name="com.example.companion" />
        <intent>
            <action android:name="com.aistudio.bridge.ACTION_DATA_EXCHANGE" />
        </intent>
    </queries>

    <application
        android:name=".SocialAgentApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SocialAgent">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SocialAgent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Offline IPC Bridge ContentProvider for companion app communication -->
        <provider
            android:name="com.example.bridge.SocialAgentBridgeProvider"
            android:authorities="${applicationId}.bridge.provider"
            android:exported="true" />

        <!-- Background ContentObserver Service for real-time Companion app changes -->
        <service
            android:name="com.example.bridge.BridgeContentObserverService"
            android:exported="false" />
    </application>

</manifest>
